<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.mapper.FavoriteMapper">

    <insert id="save">
        insert into favorite(
        user_id,
        item_id
        ) values(
        #{userId},
        #{itemId}
        )
    </insert>

    

    <delete id="deleteById">
        delete from favorite where item_id=#{itemId}
    </delete>

    <select id="list" resultType="com.example.springboot.entity.Favorite">
        select
        id,
        user_id,
        item_id
        from favorite
        order by id desc
    </select>

    <select id="listByCondition" resultType="com.example.springboot.entity.Favorite">
        select
        *
        from favorite
        <where>
            <if test="userId != null and userId !=''">
                user_id =#{userId}
            </if>
            <if test="itemId != null and itemId !=''">
                and item_id =#{itemId}
            </if>
        </where>
    </select>

    <select id="getById" resultType="com.example.springboot.entity.Favorite">
        select
        id,
        user_id,
        item_id,
        status
        from favorite
        where item_id = #{itemId}
    </select>
    <select id="getByAllId" resultType="com.example.springboot.entity.Favorite">
        select
        id,
        user_id,
        item_id,
        status
        from favorite
        where item_id = #{itemId}
    </select>
    <select id="getByStatus" resultType="java.lang.Integer">
        select
        status
        from favorite
        where item_id = #{itemId} and user_id=#{userId}
    </select>
    <select id="getByUserId" resultType="com.example.springboot.entity.Favorite">
        select
        id,
        user_id,
        item_id,
        status
        from favorite
        where user_id = #{userId}
    </select>

</mapper>